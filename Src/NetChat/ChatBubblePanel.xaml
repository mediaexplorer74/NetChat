<UserControl x:Class="IGM.UI.ChatBubblePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:IGM.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
             
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter" />
        <local:StringFormatConverter x:Key="StringFormatConverter" />
    </UserControl.Resources>
             
    <Grid Margin="5,5,5,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="0px" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40px" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <ListView Name="lvChat" 
                  Grid.ColumnSpan="2" 
                  Grid.Row="1" 
                  Grid.Column="0" 
                  Margin="0,24,0,24" 
                  VerticalAlignment="Stretch" 
                  SelectionMode="None" 
                  HorizontalAlignment="Stretch"
                  Background="Transparent"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="5,3,5,3" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Received Message (Left-aligned) -->
                        <Border x:Name="ReceivedBubble"
                                Grid.Column="0"
                                Background="#E5E5EA"
                                Padding="12,8,12,8"
                                Margin="10,0,50,0"
                                HorizontalAlignment="Left"
                                MaxWidth="300"
                                Visibility="{Binding IsFromMe, Converter={StaticResource BoolToVisibilityInverseConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SenderName}" 
                                          FontSize="12" 
                                          FontWeight="SemiBold" 
                                          Foreground="#007AFF" 
                                          Margin="0,0,0,2"
                                          Visibility="{Binding ShowSenderName, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{Binding MessageText}" 
                                          Foreground="Black" 
                                          TextWrapping="Wrap" 
                                          FontSize="14" />
                                <TextBlock Text="{Binding Timestamp, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:HH:mm}'}" 
                                          FontSize="11" 
                                          Foreground="#8E8E93" 
                                          HorizontalAlignment="Right" 
                                          Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        
                        <!-- Sent Message (Right-aligned) -->
                        <Border x:Name="SentBubble"
                                Grid.Column="2"
                                Background="#007AFF"
                                Padding="12,8,12,8"
                                Margin="50,0,10,0"
                                HorizontalAlignment="Right"
                                MaxWidth="300"
                                Visibility="{Binding IsFromMe, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding MessageText}" 
                                          Foreground="White" 
                                          TextWrapping="Wrap" 
                                          FontSize="14" />
                                <TextBlock Text="{Binding Timestamp, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:HH:mm}'}" 
                                          FontSize="11" 
                                          Foreground="#B3D7FF" 
                                          HorizontalAlignment="Right" 
                                          Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <!-- Modern Input Area -->
        <Border Grid.Row="2" 
                Grid.ColumnSpan="2"
                Background="#F2F2F7"
                Padding="5"
                BorderBrush="#E5E5EA"
                BorderThickness="1"
                Margin="1,1,1,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="tbSend" 
                         Grid.Column="0"
                         InputScope="Chat" 
                         PlaceholderText="Type a message..."
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="14"
                         VerticalAlignment="Center"
                         Margin="0,0,0,0" />
                         
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="send" 
                            Width="40" 
                            Height="40"
                            Background="#007AFF"
                            BorderThickness="0"
                            Margin="0,0,5,0">
                        <SymbolIcon Symbol="Send" Foreground="White" />
                    </Button>
                    
                    <ToggleButton x:Name="tgTextToSpeech" 
                                  Width="40" 
                                  Height="40"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Margin="0,0,5,0"
                                  IsChecked="{Binding IsSpeechEnabled, Mode=TwoWay}">
                        <SymbolIcon Symbol="Volume" Foreground="#8E8E93" />
                    </ToggleButton>
                    
                    <ToggleButton x:Name="tgHelp" 
                                  Width="40" 
                                  Height="40"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsChecked="{Binding IsAssistantEnabled, Mode=TwoWay}">
                        <SymbolIcon Symbol="Help" Foreground="#8E8E93" />
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>
        
        <MediaElement x:Name="meChatVoice" 
                      Grid.Column="1" 
                      HorizontalAlignment="Left" 
                      Height="20" 
                      Grid.RowSpan="2" 
                      VerticalAlignment="Center" 
                      Width="80" />
    </Grid>
</UserControl>