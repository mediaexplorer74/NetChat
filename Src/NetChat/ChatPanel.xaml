<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:local="using:IGM.UI" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             x:Class="IGM.UI.ChatPanel">
    
    <Grid Margin="20,20,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="20px" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40px" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="80px" />
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70px" />
                <ColumnDefinition Width="70px" />
                <ColumnDefinition Width="70px" />
                <ColumnDefinition Width="70px" />
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Delivered" Foreground="White" FontSize="14" />
            <TextBlock Grid.Column="1" Text="Received" Foreground="Cyan" FontSize="14" />
            <TextBlock Grid.Column="2" Text="Sending" Foreground="LightBlue" FontSize="14" />
            <TextBlock Grid.Column="3" Text="Lost" Foreground="Gray" FontSize="14" />
        </Grid>
        
        <ScrollViewer Name="chatScroll" Grid.ColumnSpan="2" Grid.Row="1" Grid.Column="0" Margin="0,0,0,24" VerticalScrollMode="Auto" VerticalAlignment="Bottom">
            <TextBlock Name="tbMessages" HorizontalAlignment="Left" Margin="0,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" FontSize="18" />
        </ScrollViewer>
        
        <TextBox  Name="tbSend" InputScope="Chat" Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Stretch" />
        <Button  x:Name="send" Margin="0,0,0,0" Content="Send" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center" />
        <MediaElement x:Name="meChatVoice" Grid.Column="1" HorizontalAlignment="Left" Height="20" VerticalAlignment="Top" Width="80" />
    </Grid>
</UserControl>