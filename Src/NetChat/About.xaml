<UserControl x:Class="IGM.UI.About"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:IGM.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
             
    <Grid Margin="20,20,20,20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Name="tbHow" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Margin="0,10,0,50" 
                       TextWrapping="Wrap" 
                       Text="To use this app, install on multiple devices on the same wifi/local network. You can start chatting across multiple phones and computers without internet." />
                       
            <TextBlock Name="tbVersion" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" />
                       
            <Button Name="feedbackButton" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Visibility="Collapsed" 
                    Margin="0,10,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Text="&#xE76E;" 
                               Margin="0,0,0,0" 
                               FontFamily="Segoe MDL2 Assets" />
                    <TextBlock Name="tbFeedback" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Text="Feedback" 
                               Margin="10,0,0,0" />
                </StackPanel>
            </Button>
            
            <Button Name="btnShare" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <SymbolIcon Symbol="ReShare" />
                    <TextBlock Name="tbShare" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Text="Share" 
                               Margin="10,0,0,0" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>