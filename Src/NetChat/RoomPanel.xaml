<UserControl x:Class="IGM.UI.RoomPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:IGM.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
             
    <UserControl.Resources>
        <ResourceDictionary>
            <local:StringFormatConverter x:Key="StringFormat" />
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <ListBox Name="lbRooms" 
                 Background="#CC323030" 
                 Foreground="#FFA8A0A0" 
                 FontSize="18" 
                 SelectionMode="Single" 
                 VerticalAlignment="Stretch" 
                 Grid.Row="0" 
                 Grid.Column="0"
                 ItemsSource="{Binding}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Stretch" 
                                    Grid.Column="0">
                            <TextBlock Text="{Binding RoomName}" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding PeerCount, Converter={StaticResource StringFormat}, ConverterParameter=' ({0})'}"
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Right" 
                                       Width="100" />
                        </StackPanel>
                        
                        <SymbolIcon Grid.Column="1"
                                    Symbol="{Binding SignalSymbol, Mode=OneWay}"
                                    Foreground="{Binding SignalColor, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <Button x:Name="btnNewTemporaryRoom" 
                Content="Create Temporary Room" 
                HorizontalAlignment="Stretch" 
                Margin="0,10,0,5" 
                VerticalAlignment="Center" 
                Grid.Row="1" 
                Grid.Column="0" />
    </Grid>
</UserControl>
